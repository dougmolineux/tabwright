{
  "manifest_version": 3,
  "name": "Tabwright",
  "version": "0.1.0",
  "description": "Lets Claude Code read and operate tabs you allow, with your approval for anything consequential.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabwright@dougmolineux.dev",
      "strict_min_version": "128.0"
    }
  },
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage", "notifications", "activeTab"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"], "type": "module" },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tabwright",
    "default_icon": { "48": "icons/48.png", "96": "icons/96.png" }
  },
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Tabwright",
    "default_icon": { "48": "icons/48.png", "96": "icons/96.png" },
    "open_at_install": false
  },
  "icons": { "48": "icons/48.png", "96": "icons/96.png" }
}
